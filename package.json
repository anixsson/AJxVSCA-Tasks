{
  "name": "AJxVSCA-Tasks",
  "displayName": "AJxVSCA Tasks",
  "description": "Sidebar view listing and running workspace tasks or a shared tasks.json library",
  "version": "0.4.4",
  "publisher": "ajxsystems",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/anixsson/AJxVSCA-Tasks.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "activationEvents": [
    "workspaceContains:.vscode/tasks.json"
  ],
  "contributes": {
    "colors": [
      {
        "id": "taskAccordion.sharedForeground",
        "description": "Icon color identifying the active shared command library.",
        "defaults": {
          "dark": "#3794ff",
          "light": "#007acc",
          "highContrast": "#3794ff",
          "highContrastLight": "#007acc"
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "taskAccordion.shared",
        "required": [
          "path",
          "label"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "URI of the shared task file."
          },
          "label": {
            "type": "string",
            "description": "Task label within the shared file."
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskAccordion",
          "title": "Tasks",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "taskAccordion": [
        {
          "id": "taskAccordion.libraries",
          "name": "Task Libraries"
        },
        {
          "id": "taskAccordion.tasks",
          "name": "Commands"
        },
        {
          "id": "taskAccordion.help",
          "name": "How to use",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "taskAccordion.run",
        "title": "Run Task",
        "icon": {
          "light": "media/run-green.svg",
          "dark": "media/run-green.svg"
        }
      },
      {
        "command": "taskAccordion.runGroup",
        "title": "Run Group",
        "icon": {
          "light": "media/run-group-green.svg",
          "dark": "media/run-group-green.svg"
        }
      },
      {
        "command": "taskAccordion.refresh",
        "title": "Refresh Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "taskAccordion.sort",
        "title": "Sort Tasks",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "taskAccordion.openFile",
        "title": "Open tasks.json",
        "icon": "$(go-to-file)"
      },
      {
        "command": "taskAccordion.loadFile",
        "title": "Load Shared tasks.json",
        "icon": "$(folder-opened)"
      },
      {
        "command": "taskAccordion.useWorkspace",
        "title": "Use Workspace Tasks",
        "icon": "$(home)"
      },
      {
        "command": "taskAccordion.removeSharedFile",
        "title": "Remove Shared File from Library",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "taskAccordion.loadFile",
          "when": "view == taskAccordion.libraries",
          "group": "navigation@0"
        },
        {
          "command": "taskAccordion.openFile",
          "when": "view == taskAccordion.tasks",
          "group": "navigation@3"
        },
        {
          "command": "taskAccordion.refresh",
          "when": "view == taskAccordion.tasks",
          "group": "navigation@4"
        },
        {
          "command": "taskAccordion.sort",
          "when": "view == taskAccordion.tasks",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "taskAccordion.removeSharedFile",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "taskAccordion.removeSharedFile",
          "when": "view == taskAccordion.libraries && viewItem == sharedSource",
          "group": "inline"
        },
        {
          "command": "taskAccordion.run",
          "when": "view == taskAccordion.tasks && viewItem == task",
          "group": "inline"
        },
        {
          "command": "taskAccordion.runGroup",
          "when": "view == taskAccordion.tasks && viewItem == group",
          "group": "inline"
        }
      ]
    }
  }
}
